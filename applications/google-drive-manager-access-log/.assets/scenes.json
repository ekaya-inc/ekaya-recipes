      ]
    },
    {
      "id": "s03-cloud",
      "narration": "First, prepare Google Cloud. Turn on the Admin SDK API. Set your consent screen's audience to Internal. Then create a Desktop app client, and download its JSON file. Keep that file private.",
      "shots": [
        {
          "image": "020--cloud.png",
          "focus": [
            0,
            0,
            1280,
            720
          ],
          "frame": [
            96,
            110,
            1088,
            500
          ],
          "zoom": 1.12
        }
      ]
    },
    {
      "id": "s04-prompt",
      "narration": "Now paste this Recipe's prompt into your agent. It creates a connection, and runs a small sign-in script on your computer. Your browser opens. Sign in as the administrator, and approve read-only access to the audit log.",
      "shots": [
        {
          "image": "030--prompt.png",
