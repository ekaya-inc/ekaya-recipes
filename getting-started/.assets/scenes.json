    {
      "id": "s01-sign-in",
      "narration": "Welcome to Ekaya. In this video, you'll create your first project and connect it to your AI agent.",
      "shots": [
        {"image": "000--sign-up.png", "focus": [416, 60, 448, 550], "zoom": 1.2}
      ]
    },
    {
      "id": "s02-projects",
      "narration": "Once you're in, you land on your Projects page. A project is where your data, your applications, and your users come together. Each project is separate from every other project, with its own billing. To start, select Create Project.",
      "shots": [
        {"image": "010--no-projects.png", "focus": [0, 60, 900, 420], "zoom": 1.0},
        {"at": "To start, select", "image": "010--no-projects.png", "focus": [1098, 97, 150, 35], "zoom": 1.6, "highlight": true, "cursor": {"from": [760, 330], "to": [1173, 115]}}
      ]
    },
    {
      "id": "s03-hosting",
      "narration": "First, choose where your project is hosted. In Ekaya Cloud, Ekaya hosts everything for you. Local on Premise keeps your project on your own infrastructure. For this walkthrough, choose Ekaya Cloud.",
      "shots": [
        {"image": "020--create-project-hosting.png", "focus": [288, 120, 704, 260], "zoom": 1.3},
        {"at": "For this walkthrough", "image": "020--create-project-hosting.png", "focus": [314, 202, 320, 165], "zoom": 1.45, "highlight": true, "cursor": {"from": [860, 440], "to": [474, 290]}}
      ]
    },
    {
      "id": "s04-name-region",
      "narration": "Give your project a name. Then select Create project.",
      "shots": [
        {"image": "030--create-project-form.png", "focus": [314, 266, 653, 35], "zoom": 1.45, "highlight": true},
        {"at": "Then select Create project", "image": "030--create-project-form.png", "focus": [865, 118, 127, 36], "zoom": 1.3, "highlight": true, "cursor": {"from": [640, 400], "to": [928, 136]}}
      ]
    },
    {
      "id": "s05-permissions",
      "narration": "Ekaya creates your project and opens Setup. The first step is to connect your agent. Leave Full permissions turned on. It allows your administrator agent to set up your project for you.",
